@baseUrl = http://localhost:8000

### ===============================
### Health check
### ===============================
GET {{baseUrl}}/health

### ===============================
### Registro de usuario
### ===============================
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "email": "test@example.com",
    "password": "Test1234!",
    "full_name": "Test User",
    "birth_date": "1990-01-01",
    "gender": "otro",
    "education_level": "universitario",
    "continent_code": "SA",
    "continent_name": "Sudamérica",
    "country_code": "BR",
    "country_name": "Brasil",
    "state_code": "SC",
    "state_name": "Santa Catarina",
    "city_name": "Florianópolis",
    "whatsapp_e164": "+5551987654321",
    "language_code": "pt",
    "current_situation": "estudiando",
    "interest_areas": ["tecnologia", "educacion"],
    "known_technologies": ["Python"],
    "bio": "Test bio"
}

### ===============================
### Login
### ===============================
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "test@example.com",
    "password": "Test1234!"
}

### ===============================
### Crear evento comunitario
### ===============================
POST {{baseUrl}}/events
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "title": "Charla: Cómo entrar a tecnología desde cero",
    "description": "Conversatorio sobre el camino para migrar a IT sin título formal.",
    "tipo": "online",
    "categoria": "carrera",
    "event_date": "2025-12-20T19:00:00Z",
    "max_participants": 50
}

### ===============================
### Listar eventos
### ===============================
GET {{baseUrl}}/events
Authorization: Bearer {{token}}

### ===============================
### Obtener evento por ID
### ===============================
GET {{baseUrl}}/events/<REEMPLAZAR_CON_ID>
Authorization: Bearer {{token}}

### ===============================
### Experiencias (requiere ubicación)
### ===============================
POST {{baseUrl}}/experiencias
Content-Type: application/json

{
    "lat": -27.595,
    "lng": -48.548,
    "hora_actual": "TARDE",
    "edad": 25,
    "area": "desarrollo",
    "objetivo": "crecimiento"
}
